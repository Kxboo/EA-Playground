{
  "_comment": "EAGL mesh descriptor layout definitions. Scoring replaces magic-byte dict lookup: every layout is scored against every candidate descriptor offset, and the winner is chosen if it clears MIN_SCORE (130) and leads by at least MARGIN (30).",
  "_scoring": {
    "MIN_SCORE": 130,
    "MARGIN": 30,
    "check_types": {
      "magic": "desc[offset] == value. Strongest single signal.",
      "reloc_exists": "relocs table contains an entry at (desc_off + offset).",
      "reloc_nonzero": "relocs table contains an entry at (desc_off + offset) AND its value is > 0. Filters null-pointer relocs.",
      "reloc_order": "reloc values at offsets[0] < offsets[1] (< offsets[2] if present). All must be > 0.",
      "count_range": "Big-endian u32 at offset is in [min, max]. Validates stored array counts (A/B only).",
      "reloc_absent": "relocs table does NOT contain an entry at (desc_off + offset)."
    }
  },
